---
import { Picture } from "astro:assets";
import avatar from "../assets/avatar.jpg";
import type { View } from "../lib/view.ts";
import WorldMap from "./WorldMap.astro";

interface Props {
  v: View;
}
const { v } = Astro.props;
const { ui } = v;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const home = `${base}${v.alternates.find((a) => a.lang === v.lang)?.path ?? ""}`;
const [firstName, ...restName] = v.name.split(" ");
const initials = v.name.split(" ").slice(0, 2).map((w) => w.charAt(0)).join("");
const two = (n: number) => String(n).padStart(2, "0");
const cardColors = ["--mag", "--org", "--teal", "--gold"];
const pinColors = ["#19e3d4", "#ff7a3d", "#ff2d78", "#ffc35c"];
const ticker = [...v.ticker, ...v.ticker];
const schools = v.training.reduce<{ institution: string; degrees: typeof v.training }[]>((acc, t) => {
  const school = acc.find((s) => s.institution === t.institution);
  if (school) school.degrees.push(t);
  else acc.push({ institution: t.institution, degrees: [t] });
  return acc;
}, []);
const level = v.skills.filter((s) => s.level !== undefined);
const plain = v.skills.filter((s) => s.level === undefined);
const linkIcon = (url: string) => (url.includes("linkedin.") ? "in" : url.includes("github.") ? "code" : "link");

const icons = {
  mail: '<svg viewBox="0 0 24 24" fill="none" stroke="#07030d" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>',
  call: '<svg viewBox="0 0 24 24" fill="#07030d" aria-hidden="true"><path d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>',
  code: '<svg viewBox="0 0 24 24" fill="none" stroke="#07030d" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/></svg>',
  link: '<svg viewBox="0 0 24 24" fill="none" stroke="#07030d" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>',
  doc: '<svg viewBox="0 0 24 24" fill="none" stroke="#07030d" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 13h6M9 17h6"/></svg>',
};
---

<a class="skip" href="#main">{ui.skip}</a>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="palm" viewBox="0 0 210 420">
    <path d="M100 420 C96 330 88 250 106 152 L116 152 C102 250 110 330 118 420 Z" />
    <path d="M110 150 Q58 106 6 162 Q62 126 110 160 Z" />
    <path d="M110 150 Q70 76 26 66 Q78 98 111 158 Z" />
    <path d="M110 150 Q104 86 126 34 Q118 100 116 154 Z" />
    <path d="M110 150 Q160 78 200 84 Q152 104 113 158 Z" />
    <path d="M110 150 Q172 118 206 186 Q160 134 111 160 Z" />
    <path d="M110 152 Q78 164 46 222 Q86 172 111 158 Z" />
    <path d="M110 152 Q150 166 166 228 Q140 174 111 158 Z" />
    <circle cx="104" cy="160" r="6" /><circle cx="116" cy="162" r="6" />
  </symbol>
</svg>

<div class="page">
  <header class="hud cond">
    <a class="hud__id" href={home}><span class="badge" aria-hidden="true"><span>{initials}</span></span>{v.name}</a>
    <nav class="hud__nav" aria-label={ui.skip}>
      <a href="#current">{ui.nav.mission}</a>
      <a href="#stats">{ui.nav.stats}</a>
      <a href="#map">{ui.nav.map}</a>
      <a href="#phone">{ui.nav.phone}</a>
    </nav>
    <div class="hud__right">
      <span class="stars"><span aria-hidden="true">★★★★★</span><small>{ui.level}</small></span>
      <nav class="lang" aria-label="Language">
        {
          v.alternates.map((a) => (
            <a href={`${base}${a.path}`} hreflang={a.lang} lang={a.lang} aria-current={a.lang === v.lang ? "page" : undefined}>
              {a.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <section class="hero" aria-labelledby="name">
    <div class="scene" aria-hidden="true">
      <div class="sun"></div>
      <svg class="skyline" viewBox="0 0 600 90" preserveAspectRatio="none" fill="#2a0b45">
        <path d="M0 90V62h28V40h18v22h20V30h14V12h10v18h12v32h22V48h26v42zM180 90V54h24V26h30v28h16V44h20v46zM300 90V36h12V18h20v18h12v54zM370 90V58h30V40h22v18h18V30h16v60zM470 90V50h20V22h8V6h6v16h8v28h22v40zM550 90V60h20V44h30v46z"></path>
      </svg>
      <div class="sea"></div>
      <svg class="palms2" viewBox="0 0 210 420" fill="#07030d"><use href="#palm"></use></svg>
      <svg class="palms" viewBox="0 0 210 420" fill="#07030d"><use href="#palm"></use></svg>
    </div>
    <div class="seam" aria-hidden="true"></div>
    <div class="edge" aria-hidden="true"></div>
    <div class="shot">
      <Picture
        src={avatar}
        alt=""
        formats={["avif", "webp"]}
        widths={[360, 560, 896]}
        sizes="(max-width: 760px) 100vw, 560px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <p class="tag cond"><b>{ui.player}</b><span>{v.location}</span></p>
    <div class="title">
      <p class="script">{v.headline[0]}</p>
      <h1 class="name" id="name">{firstName}<br />{restName.join(" ")}</h1>
      <ul class="roles cond">{v.headline.slice(1).map((h) => <li>{h}</li>)}</ul>
      <p class="blurb" set:html={v.intro} />
      <div class="ctas">
        <a class="btn btn--hot" href={v.pdf} hreflang={v.lang}><Fragment set:html={icons.doc} />{ui.cta.pdf}</a>
        <a class="btn btn--ghost" href="#current">{ui.cta.start} →</a>
      </div>
    </div>
  </section>

  <div class="ticker cond" aria-hidden="true">
    <div class="ticker__track">{ticker.map((t) => <span>{t}</span>)}</div>
  </div>

  <dl class="counters">
    {
      v.counters.map((c) => (
        <div class="counter">
          <dt class="cond">{c.label}</dt>
          <dd>{c.value}</dd>
        </div>
      ))
    }
  </dl>

  <main id="main">
    <section id="current" aria-labelledby="h-current">
      <header class="sec">
        <span class="sec__n" aria-hidden="true">01</span>
        <div><p class="sec__k cond">{ui.sections.current[1]}</p><h2 id="h-current">{ui.sections.current[0]}</h2></div>
      </header>
      <article class="brief">
        <div class="brief__main">
          {v.featured.current && <span class="status cond"><i aria-hidden="true"></i>{ui.status}</span>}
          <h3>{v.featured.company}</h3>
          <p class="meta cond">{v.featured.role} · {v.featured.period} · {v.featured.location}</p>
          {v.featured.summary && <p class="desc" set:html={v.featured.summary} />}
          <p class="lbl cond" style="margin-top:16px">{ui.objectives}</p>
          {v.featured.highlights.length > 0 && <ul class="obj">{v.featured.highlights.map((h) => <li><span set:html={h} /></li>)}</ul>}
          {
            v.featured.cards.map((c) => (
              <div class="op">
                <h4>{c.name}</h4>
                {c.description && <p>{c.description}</p>}
                <ul class="obj">{c.highlights.map((h) => <li><span set:html={h} /></li>)}</ul>
              </div>
            ))
          }
        </div>
        <aside class="brief__side">
          <div class="brief__pin">
          {
            v.rewards.length > 0 && (
              <>
                <p class="lbl cond">{ui.rewards}</p>
                <dl class="rewards">
                  {v.rewards.map((m) => (
                    <div class="reward">
                      <dt>{m.label}</dt>
                      <dd>{m.value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )
          }
          {
            v.featured.stack.length > 0 && (
              <>
                <p class="lbl cond">{ui.loadout}</p>
                <ul class="stack">{v.featured.stack.map((s) => <li>{s}</li>)}</ul>
              </>
            )
          }
          </div>
        </aside>
      </article>
    </section>

    {
      v.groups.length > 0 && (
        <section id="missions" aria-labelledby="h-missions">
          <header class="sec">
            <span class="sec__n" aria-hidden="true">02</span>
            <div><p class="sec__k cond">{ui.sections.missions[1]}</p><h2 id="h-missions">{ui.sections.missions[0]}</h2></div>
          </header>
          {v.groups.map((g) => (
            <>
              <div class="contract">
                <h3>{g.company}</h3>
                <span class="cond">{g.role}</span>
                <span class="cond">{g.period} · {g.location}</span>
              </div>
              {g.summary && <p class="contract__about" set:html={g.summary} />}
              <div class="missions">
                {g.cards.map((c, i) => (
                  <article class="mcard" style={`--c:var(${cardColors[i % cardColors.length]})`}>
                    <div class="mcard__bar" />
                    <span class="mcard__num" aria-hidden="true">M-{two(i + 1)}</span>
                    <div class="mcard__body">
                      {c.description && <p class="mcard__k cond">{c.description}</p>}
                      <h4>{c.name}</h4>
                      {c.role && <p class="role cond">{c.role}</p>}
                      <ul class="obj">{c.highlights.map((h) => <li><span set:html={h} /></li>)}</ul>
                      {c.metrics.length > 0 && <ul class="chips">{c.metrics.map((m) => <li>{m.value} {m.label}</li>)}</ul>}
                      {c.stack.length > 0 && <ul class="stack">{c.stack.map((s) => <li>{s}</li>)}</ul>}
                    </div>
                  </article>
                ))}
              </div>
            </>
          ))}
        </section>
      )
    }

    <section id="side" aria-labelledby="h-side">
      <header class="sec">
        <span class="sec__n" aria-hidden="true">03</span>
        <div><p class="sec__k cond">{ui.sections.side[1]}</p><h2 id="h-side">{ui.sections.side[0]}</h2></div>
      </header>
      <div class={v.side.length === 2 ? "trio trio--two" : "trio"}>
        {
          v.side.map((c) => (
            <article class="scard">
              <p class="k cond">◆ {ui.side}</p>
              <h3>{c.name}</h3>
              {c.period && <p class="when cond">{c.period}</p>}
              {c.description && <p class="sub2">{c.description}{c.role && ` · ${c.role}`}</p>}
              {c.highlights.map((h) => <p set:html={h} />)}
              {c.metrics.length > 0 && <ul class="chips">{c.metrics.map((m) => <li>{m.value} {m.label}</li>)}</ul>}
              {c.stack.length > 0 && <ul class="stack">{c.stack.map((s) => <li>{s}</li>)}</ul>}
            </article>
          ))
        }
      </div>
      <p class="sub cond">{ui.chapters}</p>
      <div class="trio">
        {
          v.chapters.map((c) => (
            <article class="scard">
              {!c.current && <span class="stamp">{ui.complete.toUpperCase()}</span>}
              <h3>{c.company}</h3>
              <p class="when cond">{c.period}</p>
              <p class="sub2">{c.role} · {c.location}</p>
              {c.highlights.map((h) => <p set:html={h} />)}
            </article>
          ))
        }
        {
          schools.map((s) => (
            <article class="scard">
              <p class="k cond">◆ {ui.training}</p>
              <h3>{s.institution}</h3>
              {s.degrees.map((d) => (
                <p>
                  {d.degree}
                  <br />
                  <span class="when cond">{d.period}</span>
                </p>
              ))}
            </article>
          ))
        }
      </div>
    </section>

    <section id="stats" aria-labelledby="h-stats">
      <header class="sec">
        <span class="sec__n" aria-hidden="true">04</span>
        <div><p class="sec__k cond">{ui.sections.stats[1]}</p><h2 id="h-stats">{ui.sections.stats[0]}</h2></div>
      </header>
      <div class="duo">
        <div class="panel">
          {
            level.map((s) => (
              <div class="stat">
                <div class="stat__top cond"><span>{s.name}</span><span class="stat__lvl">{s.rank}</span></div>
                <div class="bar" role="meter" aria-label={s.name} aria-valuenow={s.level} aria-valuemin="0" aria-valuemax="100">
                  <i style={`--v:${s.level}%`} />
                </div>
                <p class="stat__d">{s.items.join(", ")}</p>
              </div>
            ))
          }
          {plain.map((s) => <p class="langs cond">{s.name}: {s.items.join(" · ")}</p>)}
        </div>
        <div class="panel map" id="map">
          <p class="lbl cond">{ui.map}</p>
          <WorldMap pins={v.pins} colors={pinColors} />
          <ul class="intel">
            {
              v.pins.map((p) => {
                const others = v.pins.filter((x) => x.id !== "home");
                const color = p.id === "home" ? "#ffc35c" : pinColors[others.indexOf(p) % pinColors.length];
                return (
                  <li>
                    <i style={`background:${color}`} />
                    <span class="cond">{p.label}</span>
                    <b>{p.place}</b>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="phone" aria-labelledby="h-phone">
      <header class="sec">
        <span class="sec__n" aria-hidden="true">05</span>
        <div><p class="sec__k cond">{ui.sections.phone[1]}</p><h2 id="h-phone">{ui.sections.phone[0]}</h2></div>
      </header>
      <div class="contact">
        <div>
          <h3>{ui.contact}</h3>
          <p set:html={v.pitch} />
          <div class="ctas">
            <a class="btn btn--hot" href={`mailto:${v.email}`}>{v.email}</a>
            <a class="btn btn--ghost" href={`tel:${v.tel}`}>{v.phone}</a>
          </div>
          <ul class="pdfs">
            {
              v.pdfs.map((p) => (
                <li>
                  <a class="pdf" href={p.url} hreflang={p.lang}>
                    <Fragment set:html={icons.doc} />
                    <span><b>CV · {p.label}</b>{ui.pdf}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="phone">
          <div class="screen">
            <div class="sb cond" aria-hidden="true"><span>LTE ▂▄▆</span><span data-clock></span><span>▮▮▮▯</span></div>
            <div class="clock" data-clock aria-hidden="true"></div>
            <div class="date cond" data-date aria-hidden="true"></div>
            <ul class="apps">
              <li><a class="app" href={`mailto:${v.email}`}><i style="background:var(--teal)"><Fragment set:html={icons.mail} /></i>{ui.apps.email}</a></li>
              <li><a class="app" href={`tel:${v.tel}`}><i style="background:var(--gold)"><Fragment set:html={icons.call} /></i>{ui.apps.call}</a></li>
              {
                v.links.map((l, i) => (
                  <li>
                    <a class="app" href={l.url} rel="me noopener" target="_blank">
                      <i style={`background:var(${i % 2 ? "--pink" : "--cream"})`}>
                        {linkIcon(l.url) === "in" ? "in" : <Fragment set:html={icons[linkIcon(l.url) as "code" | "link"]} />}
                      </i>
                      {l.url.includes("linkedin.") ? ui.apps.linkedin : l.url.includes("github.") ? ui.apps.github : l.label}
                    </a>
                  </li>
                ))
              }
              {
                v.pdfs.map((p, i) => (
                  <li>
                    <a class="app" href={p.url} hreflang={p.lang}>
                      <i style={`background:var(${i % 2 ? "--mag" : "--org"})`}><Fragment set:html={icons.doc} /></i>
                      CV · {p.lang.toUpperCase()}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="dock">
              <div><span>{ui.apps.email}</span>{v.email}</div>
              <div><span>{ui.apps.call}</span>{v.phone}</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <p>{ui.footer} <a href={v.repository}>{ui.source}</a></p>
    <p>{ui.disclaimer}</p>
  </footer>
</div>

<script is:inline define:vars={{ lang: v.lang }}>
  const date = new Intl.DateTimeFormat(lang, { weekday: "short", day: "numeric", month: "short" });
  const time = new Intl.DateTimeFormat(lang, { hour: "2-digit", minute: "2-digit", hour12: false });
  const tick = () => {
    const now = new Date();
    document.querySelectorAll("[data-clock]").forEach((el) => (el.textContent = time.format(now)));
    document.querySelectorAll("[data-date]").forEach((el) => (el.textContent = date.format(now).toUpperCase()));
  };
  tick();
  setInterval(tick, 30000);
</script>
